{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Сборка exe",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/build.py"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUNBUFFERED": "1"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
