# Базовый URL бэкенда Vitago (без завершающего слэша)
API_BASE_URL=http://200.165.231.43

# URL чата поддержки по умолчанию для визарда клона
DEFAULT_SUPPORT_CHAT_URL=https://t.me/vitago_support

# Таймаут HTTP-запросов в секундах
API_TIMEOUT_SECONDS=30

# SSH к серверу для секретов Docker (не API бэкенда)
SECRETS_SSH_HOST=200.165.231.43
SECRETS_SSH_USER=root
SECRETS_SSH_KEY=.ssh/id_ed25519
SECRETS_REMOTE_PATH=/opt/vitago-backend

# Бэкап папки ресурсов на сервере: раз в N дней в backups/disk-ГГГГ-ММ-ДД.tar.gz. 0 — выкл
SERVER_DISK_BACKUP_DAYS=0
